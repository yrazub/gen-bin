---
import '../styles/tokens.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  current?: 'search' | 'whats-new' | 'team';
}
const { title, description = 'Claude Code plugin marketplace', current } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%230969da' stroke-width='2' stroke-linejoin='round'%3E%3Cpath d='M21 8l-9-5-9 5v8l9 5 9-5zM3 8l9 5 9-5M12 13v8'/%3E%3C/svg%3E" />
    <link rel="alternate" type="application/rss+xml" title="gen-bin releases" href={url('rss.xml')} />
    <script is:inline>
      try {
        var t = localStorage.getItem('gen-bin:theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <SiteHeader current={current} />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    color-scheme: light dark;
  }
  html[data-theme='light'] {
    color-scheme: light;
  }
  html[data-theme='dark'] {
    color-scheme: dark;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.55 var(--font-sans);
  }
  a {
    color: var(--accent);
  }
  main {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-6) var(--gutter) 0;
  }
  h1 {
    font-size: 32px;
    line-height: 1.25;
    font-weight: 600;
    margin: 0 0 var(--space-3);
  }
  h2 {
    font-size: 22px;
    line-height: 1.3;
    font-weight: 600;
  }
  [hidden] {
    display: none !important;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  mark {
    background: var(--mark);
    color: inherit;
    border-radius: 2px;
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
