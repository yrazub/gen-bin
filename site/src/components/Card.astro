---
import CopyCommand from './CopyCommand.astro';
import TeamToggle from './TeamToggle.astro';
import TypeBadge from './TypeBadge.astro';
import type { SearchCard } from '../lib/search/card';

interface Props {
  card: SearchCard;
}
const { card } = Astro.props;
const isPlugin = card.type === 'plugin';
---

<!-- The search script clones this markup from the page's <template> and fills the data-f parts. -->
<article class="card" data-card>
  <div class="top">
    <TypeBadge type={card.type} />
    <span class="in" data-f="in" hidden={isPlugin}>in <a href={card.pluginHref} data-f="plugin-link">{card.plugin}</a></span>
    <span class="version" data-f="version">{card.version === 'unversioned' ? card.version : `v${card.version}`}</span>
  </div>
  <h3><a href={card.pluginHref} data-f="name">{card.name}</a></h3>
  <p class="invocable" data-f="invocable">{card.invocable}</p>
  <p class="description" data-f="description">{card.description}</p>
  <CopyCommand command={card.install} label="install command" />
  <div class="foot">
    <a href={card.sourceHref} data-f="source">Source ↗</a>
    <TeamToggle plugin={isPlugin ? card.plugin : ''} />
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-4);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: 13px;
    color: var(--muted);
  }
  .version {
    margin-left: auto;
    font-family: var(--font-mono);
  }
  h3 {
    margin: 0;
    font-size: 17px;
    line-height: 1.35;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  h3 a {
    color: var(--fg);
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  p {
    margin: 0;
  }
  .invocable {
    font: 13px/1.5 var(--font-mono);
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .description {
    flex: 1;
    font-size: 15px;
    overflow-wrap: anywhere;
    white-space: pre-line;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: 14px;
  }
  .foot a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
  }
</style>
