---
interface Props {
  command: string;
  /** What the button copies, for its accessible name. */
  label?: string;
}
const { command, label = 'command' } = Astro.props;
---

<div class="copy" data-copy-box>
  <code>{command}</code>
  <button type="button" data-copy={command} aria-label={`Copy ${label}`}>Copy</button>
</div>

<script>
  import '../scripts/copy';
</script>

<style>
  .copy {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--code);
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    padding: var(--space-1) var(--space-1) var(--space-1) var(--space-3);
    min-width: 0;
  }
  code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font: 13px/1.5 var(--font-mono);
    padding: var(--space-2) 0;
  }
  button {
    flex: none;
    min-height: var(--target);
    padding: 0 var(--space-3);
    background: var(--surface);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    font: 14px var(--font-sans);
    cursor: pointer;
  }
</style>
